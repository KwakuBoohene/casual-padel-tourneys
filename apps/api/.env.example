DATABASE_URL=postgresql://padel:padel@localhost:5400/padel
REDIS_URL=redis://localhost:6579
PUBLIC_API_BASE_URL=http://localhost:3001
JWT_SECRET=change_me
API_LOG_LEVEL=debug
GOOGLE_ANDROID_CLIENT_ID=change_me
GOOGLE_WEB_CLIENT_ID=change_me_web_client.apps.googleusercontent.com
# Shared organizer accounts (deploy the additive migration before enabling).
SHARED_ORGANIZER_ACCESS_ENABLED=false
# Organizer Expo web application origin, not the read-only Vite viewer origin.
ORGANIZER_WEB_BASE_URL=https://organizer.example.com

# Optional API monitoring; empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable only after admin migration and explicit operator grants.
ADMIN_PORTAL_ENABLED=false

# Viewer origin for admin magic links; no path/query/fragment.
ADMIN_WEB_BASE_URL=https://viewer.example.com

# Optional admin-only Sentry summary. API runtime only; separate from ingestion and source-map uploads.
SENTRY_HEALTH_ENABLED=false
SENTRY_HEALTH_TOKEN=
SENTRY_HEALTH_ORG=
# Explicit numeric production project IDs, comma separated; never -1/all projects.
SENTRY_HEALTH_PROJECT_IDS=
SENTRY_HEALTH_ENVIRONMENT=production
# Match the regional or self-hosted API origin used by your organization.
SENTRY_HEALTH_BASE_URL=https://sentry.io
# Keep false until the firstSeen field's environment/lifetime semantics are checked with real issues.
SENTRY_HEALTH_FIRST_SEEN_VERIFIED=false
