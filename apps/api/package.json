{
  "name": "@padel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "API_LOG_LEVEL=debug tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx $(find tests -name '*.test.ts' | sort)",
    "simulate": "node --import tsx src/engine/simulate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.0",
    "@padel/shared": "*",
    "@prisma/client": "7.9.1",
    "@serenity-kit/opaque": "1.1.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "google-auth-library": "11.0.2",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "eslint-plugin-boundaries": "7.2.0",
    "prisma": "6.19.2",
    "tsx": "4.21.0",
    "typescript-eslint": "8.67.0"
  }
}
