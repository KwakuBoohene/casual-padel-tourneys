# Viewer configuration. Copy to .env.local for local development.
#
# There is no built-in fallback: if neither variable is set the app throws rather than
# silently pointing at localhost.

# Origin the BROWSER calls — live-scoring WebSocket, export downloads, public rankings.
# Must be reachable from a visitor's device. In production this is the public https API origin
# (e.g. https://api.example.com); localhost resolves to the visitor's own machine.
PUBLIC_API_BASE_URL=http://localhost:3004

# Origin for server-side fetches from inside the container. Uses the Compose service name in
# Docker and is never seen by a browser. Falls back to PUBLIC_API_BASE_URL when unset.
INTERNAL_API_BASE_URL=http://localhost:3004
