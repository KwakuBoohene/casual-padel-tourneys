{
  "name": "@padel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "API_LOG_LEVEL=debug tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx $(find tests -name '*.test.ts' | sort)",
    "simulate": "node --import tsx src/engine/simulate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "maintenance:prune-activity": "node dist/apps/api/src/maintenance/pruneOrganizerActivity.js",
    "admin": "node --import tsx src/maintenance/platformAdmin.ts",
    "admin:production": "node dist/apps/api/src/maintenance/platformAdmin.js",
    "maintenance:prune-usage": "node dist/apps/api/src/maintenance/pruneUsage.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@padel/shared": "*",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.11.0",
    "@serenity-kit/opaque": "1.1.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.3",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.7",
    "eslint-plugin-boundaries": "7.4.2",
    "prisma": "6.19.2",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1"
  }
}
