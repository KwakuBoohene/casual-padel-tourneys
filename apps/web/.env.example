# Copy to .env.local for local Vite development.
# The API origin must be reachable from visitors' browsers.
# Localhost is allowed in development; production needs the public HTTPS API origin.
PUBLIC_API_BASE_URL=http://localhost:3004

# Docker reads PUBLIC_API_BASE_URL at container startup and writes runtime-config.json.
# Static hosting reads it at build time; restart/reconfigure Docker without rebuilding.
# INTERNAL_API_BASE_URL is no longer used by the viewer.

# Optional public viewer runtime monitoring; DSN is public, never use an API/auth token.
VIEWER_SENTRY_DSN=
VIEWER_SENTRY_ENVIRONMENT=production
VIEWER_SENTRY_RELEASE=
VIEWER_SENTRY_TRACES_SAMPLE_RATE=0.1
