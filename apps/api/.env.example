DATABASE_URL=postgresql://padel:padel@localhost:5400/padel
REDIS_URL=redis://localhost:6579
PUBLIC_API_BASE_URL=http://localhost:3001
JWT_SECRET=change_me
API_LOG_LEVEL=debug
GOOGLE_ANDROID_CLIENT_ID=change_me
GOOGLE_WEB_CLIENT_ID=change_me_web_client.apps.googleusercontent.com
# Shared organizer accounts (deploy the additive migration before enabling).
SHARED_ORGANIZER_ACCESS_ENABLED=false
# Organizer Expo web application origin, not the read-only Vite viewer origin.
ORGANIZER_WEB_BASE_URL=https://organizer.example.com

# Optional API monitoring; empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
