{
  "name": "@padel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "build": "echo \"Use EAS build in production\"",
    "build:ios": "eas build --platform ios --profile preview",
    "build:android": "eas build --platform android --profile preview",
    "build:web": "eas build --platform web --profile preview",
    "preexport:web": "npm run build --workspace @padel/shared",
    "export:web": "expo export --platform web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx $(find tests -name '*.test.ts' | sort)",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@padel/shared": "*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@serenity-kit/opaque": "1.1.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "5.104.5",
    "babel-preset-expo": "~58.0.19",
    "expo": "58.0.17",
    "expo-auth-session": "58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.10",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.20",
    "expo-web-browser": "58.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "4.23.12"
  }
}
