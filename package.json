{
  "name": "casual-padel-tourneys",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,mobile -c cyan,magenta,yellow \"npm run dev --workspace @padel/api\" \"npm run dev --workspace @padel/web\" \"npm run dev --workspace @padel/mobile\"",
    "dev:core": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace @padel/api\" \"npm run dev --workspace @padel/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run build --workspace @padel/shared && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "simulate": "npm run simulate --workspace @padel/api",
    "db:generate": "npm run db:generate --workspace @padel/api",
    "db:migrate": "npm run db:migrate --workspace @padel/api"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "concurrently": "9.2.5",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@types/react": "19.3.0",
    "dotenv": "18.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "@xmldom/xmldom@0.8": "0.8.15",
    "brace-expansion@1": "1.1.21",
    "deepmerge-ts@7": "8.0.2",
    "effect@3": "3.22.3",
    "fast-uri@3": "3.1.8",
    "js-yaml@4": "4.3.2",
    "picomatch@2": "2.3.2",
    "ws@7": "7.5.11",
    "ws@8": "8.22.0",
    "uuid": "11.1.1"
  }
}
