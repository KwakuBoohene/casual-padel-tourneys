generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TournamentMode {
  AMERICANO
  MEXICANO
}

enum TournamentVariant {
  CLASSIC
  MIXED
  TEAM
}

enum SchedulingMode {
  TARGET_GAMES
  TOTAL_TIME
  ROUND_ROBIN
}

enum ScoringMode {
  AMERICANO_POINTS
  REGULAR
}

enum RegularSetFormat {
  BO3_GAMES
  BO5_GAMES
  FULL_SET
}

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  name                   String
  avatarUrl              String?
  googleId               String?          @unique
  guestId                String?          @unique
  isGuest                Boolean          @default(false)
  emailVerifiedAt        DateTime?
  emailVerificationDueAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  tournaments            Tournament[]
  magicLinkTokens        MagicLinkToken[]
  opaqueRecord           OpaqueRecord?
}

enum MagicLinkPurpose {
  LOGIN
  VERIFY
  RESET
}

model MagicLinkToken {
  id         String           @id @default(cuid())
  userId     String
  tokenHash  String           @unique
  purpose    MagicLinkPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OpaqueRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  envelope  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tournament {
  id                    String            @id @default(cuid())
  name                  String
  mode                  TournamentMode
  variant               TournamentVariant
  schedulingMode        SchedulingMode    @default(TARGET_GAMES)
  courts                Int
  pointsPerMatch        Int
  scoringMode           ScoringMode       @default(AMERICANO_POINTS)
  regularSetFormat      RegularSetFormat?
  regularGameWinBy      Int?
  regularSetsToWin      Int?
  regularSetTiebreakTo  Int?
  regularMatchTiebreak  Boolean?
  targetGamesPerPlayer  Int?
  tournamentTimeMinutes Int?
  publicToken           String            @unique
  version               Int               @default(0)
  integrationWaveCount  Int               @default(0)
  enableAutoIntegration Boolean           @default(false)
  integrationThreshold  Int               @default(2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organizerId           String?
  organizer             User?             @relation(fields: [organizerId], references: [id])
  players               Player[]
  rounds                Round[]
  pendingPlayers        PendingPlayer[]
}

model Player {
  id              String     @id @default(cuid())
  tournamentId    String
  name            String
  gender          String?
  gamesPlayed     Int        @default(0)
  totalPoints     Int        @default(0)
  matchesWon      Int        @default(0)
  matchesLost     Int        @default(0)
  setsWon         Int        @default(0)
  setsLost        Int        @default(0)
  gamesWon        Int        @default(0)
  gamesLost       Int        @default(0)
  handicap        Float?
  integrationWave Int?
  integratedAt    DateTime?
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model PendingPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  gender       String?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  roundNumber  Int
  isLocked     Boolean    @default(false)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]
}

model Match {
  id        String     @id @default(cuid())
  roundId   String
  court     Int
  teamA     String[]
  teamB     String[]
  scoreA    Int?
  scoreB    Int?
  matchTbA  Int?
  matchTbB  Int?
  completed Boolean    @default(false)
  round     Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sets      MatchSet[]
}

model MatchSet {
  id        String @id @default(cuid())
  matchId   String
  setNumber Int
  gamesA    Int
  gamesB    Int
  tbA       Int?
  tbB       Int?
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@index([matchId])
}
