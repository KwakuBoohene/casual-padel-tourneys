EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=change_me
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=change_me_web_client.apps.googleusercontent.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_VIEWER_BASE_URL=http://localhost:3000

# Optional CPA web monitoring; these public values are embedded at build time.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional local/CI source-map upload settings (not public frontend variables).
# Export these in the build shell; use a private CI/host secret for SENTRY_AUTH_TOKEN.
# All three must be provided together. Docker uses the Compose project-specific args instead.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
