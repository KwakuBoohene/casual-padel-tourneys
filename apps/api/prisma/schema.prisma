generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TournamentMode {
  AMERICANO
  MEXICANO
  KING_OF_THE_HILL
}

enum TournamentVariant {
  CLASSIC
  MIXED
  TEAM
}

enum SchedulingMode {
  TARGET_GAMES
  TOTAL_TIME
  ROUND_ROBIN
}

enum ScoringMode {
  AMERICANO_POINTS
  REGULAR
}

enum RegularSetFormat {
  BO3_GAMES
  BO5_GAMES
  FULL_SET
}

/** KOH pairing strategy. ROUND_ROBIN_PAIRS reserved for a later epic. */
enum KohPairingMode {
  WINNER_STAYS
  ROUND_ROBIN_PAIRS
}

/** Per-game win method on KOH matches (not Americano rally points). */
enum KohGameWinMethod {
  REGULAR
  GOLDEN
  STAR
}

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  name                   String
  avatarUrl              String?
  googleId               String?          @unique
  guestId                String?          @unique
  isGuest                Boolean          @default(false)
  emailVerifiedAt        DateTime?
  emailVerificationDueAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  tournaments            Tournament[]
  magicLinkTokens        MagicLinkToken[]
  opaqueRecord           OpaqueRecord?
}

enum MagicLinkPurpose {
  LOGIN
  VERIFY
  RESET
}

model MagicLinkToken {
  id         String           @id @default(cuid())
  userId     String
  tokenHash  String           @unique
  purpose    MagicLinkPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OpaqueRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  envelope  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tournament {
  id                    String            @id @default(cuid())
  name                  String
  mode                  TournamentMode
  variant               TournamentVariant
  schedulingMode        SchedulingMode    @default(TARGET_GAMES)
  courts                Int
  pointsPerMatch        Int
  scoringMode           ScoringMode       @default(AMERICANO_POINTS)
  regularSetFormat      RegularSetFormat?
  regularGameWinBy      Int?
  regularSetsToWin      Int?
  regularSetTiebreakTo  Int?
  regularMatchTiebreak  Boolean?
  /** KOH only — null on Americano/Mexicano rows. */
  pairingMode           KohPairingMode?
  targetGamesPerPlayer  Int?
  tournamentTimeMinutes Int?
  publicToken           String            @unique
  version               Int               @default(0)
  integrationWaveCount  Int               @default(0)
  enableAutoIntegration Boolean           @default(false)
  integrationThreshold  Int               @default(2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organizerId           String?
  organizer             User?             @relation(fields: [organizerId], references: [id])
  players               Player[]
  rounds                Round[]
  pendingPlayers        PendingPlayer[]
  kohCourts             KohCourt[]
  kohPromotionRules     KohPromotionRule[]
}

model Player {
  id              String     @id @default(cuid())
  tournamentId    String
  name            String
  gender          String?
  gamesPlayed     Int        @default(0)
  totalPoints     Int        @default(0)
  matchesWon      Int        @default(0)
  matchesLost     Int        @default(0)
  setsWon         Int        @default(0)
  setsLost        Int        @default(0)
  gamesWon        Int        @default(0)
  gamesLost       Int        @default(0)
  handicap        Float?
  integrationWave Int?
  integratedAt    DateTime?
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  kohUnitsAsA     KohUnit[]  @relation("KohUnitPlayerA")
  kohUnitsAsB     KohUnit[]  @relation("KohUnitPlayerB")

  @@index([tournamentId])
}

model PendingPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  gender       String?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  roundNumber  Int
  isLocked     Boolean    @default(false)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]
}

model Match {
  id        String     @id @default(cuid())
  roundId   String
  court     Int
  teamA     String[]
  teamB     String[]
  scoreA    Int?
  scoreB    Int?
  matchTbA  Int?
  matchTbB  Int?
  completed Boolean    @default(false)
  round     Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sets      MatchSet[]
}

model MatchSet {
  id        String @id @default(cuid())
  matchId   String
  setNumber Int
  gamesA    Int
  gamesB    Int
  tbA       Int?
  tbB       Int?
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@index([matchId])
}

// ---------------------------------------------------------------------------
// King of the Hill (winner-stays) — dedicated models; do not overload Round/Match
// ---------------------------------------------------------------------------

/** One physical court on the KOH ladder (courtNumber 1 = top). */
model KohCourt {
  id           String     @id @default(cuid())
  tournamentId String
  courtNumber  Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  units        KohUnit[]
  matches      KohMatch[]

  @@unique([tournamentId, courtNumber])
  @@index([tournamentId])
}

/**
 * Doubles pair on a KOH court.
 * queuePosition: 0 = king, 1 = challenger, ≥2 = FIFO waiting.
 * Soft cap: max 12 units per court (enforced in API).
 */
model KohUnit {
  id              String   @id @default(cuid())
  courtId         String
  playerAId       String
  playerBId       String
  queuePosition   Int
  matchesWon      Int      @default(0)
  matchesLost     Int      @default(0)
  /** Consecutive wins as king — used for promotion streaks. */
  kingWinStreak   Int      @default(0)
  court           KohCourt @relation(fields: [courtId], references: [id], onDelete: Cascade)
  playerA         Player   @relation("KohUnitPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB         Player   @relation("KohUnitPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  matchesAsA      KohMatch[] @relation("KohMatchUnitA")
  matchesAsB      KohMatch[] @relation("KohMatchUnitB")
  matchesWonRef   KohMatch[] @relation("KohMatchWinner")

  @@unique([courtId, queuePosition])
  @@index([courtId])
  @@index([playerAId])
  @@index([playerBId])
}

model KohPromotionRule {
  id                   String     @id @default(cuid())
  tournamentId         String
  courtNumber          Int
  winsRequired         Int
  promoteToCourtNumber Int?
  tournament           Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, courtNumber])
  @@index([tournamentId])
}

model KohMatch {
  id           String    @id @default(cuid())
  courtId      String
  unitAId      String
  unitBId      String
  winnerUnitId String?
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  court        KohCourt  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  unitA        KohUnit   @relation("KohMatchUnitA", fields: [unitAId], references: [id], onDelete: Cascade)
  unitB        KohUnit   @relation("KohMatchUnitB", fields: [unitBId], references: [id], onDelete: Cascade)
  winnerUnit   KohUnit?  @relation("KohMatchWinner", fields: [winnerUnitId], references: [id], onDelete: SetNull)
  sets         KohMatchSet[]

  @@index([courtId])
  @@index([unitAId])
  @@index([unitBId])
}

model KohMatchSet {
  id           String            @id @default(cuid())
  matchId      String
  setNumber    Int
  gamesA       Int
  gamesB       Int
  tbA          Int?
  tbB          Int?
  /** Win method for each game won by side A (parallel to games counted). Optional until score API. */
  winMethodsA  KohGameWinMethod[]
  winMethodsB  KohGameWinMethod[]
  match        KohMatch          @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@index([matchId])
}

