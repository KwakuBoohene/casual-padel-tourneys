{
  "name": "@padel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "build": "echo \"Use EAS build in production\"",
    "build:ios": "eas build --platform ios --profile preview",
    "build:android": "eas build --platform android --profile preview",
    "build:web": "eas build --platform web --profile preview",
    "preexport:web": "npm run build --workspace @padel/shared",
    "export:web": "expo export --platform web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx $(find tests -name '*.test.ts' | sort)",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@padel/shared": "*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@serenity-kit/opaque": "1.1.0",
    "@shopify/flash-list": "2.3.3",
    "@tanstack/react-query": "5.104.0",
    "babel-preset-expo": "~57.0.13",
    "expo": "57.0.26",
    "expo-auth-session": "57.0.13",
    "expo-clipboard": "~57.0.2",
    "expo-file-system": "57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-web-browser": "57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "4.23.12"
  }
}
